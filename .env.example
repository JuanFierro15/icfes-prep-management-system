# Copia este archivo a .env y ajusta los valores.
# docker-compose lo carga automáticamente; para `mvn spring-boot:run` exporta
# estas variables en tu shell o configúralas en tu IDE.

# Conexión a PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gestionicfes?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tamao

# Credenciales del contenedor de base de datos (docker-compose)
DB_NAME=gestionicfes
DB_USER=postgres
DB_PASSWORD=tamao
